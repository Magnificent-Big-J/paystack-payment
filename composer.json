{
    "version": "1.0.0",
    "name": "rainwaves/paystack-payment",
    "description": "Laravel Paystack payment package for Rainwaves applications.",
    "keywords": [
        "rainwaves",
        "paystack-payment",
        "payments",
        "paystack"
    ],
    "homepage": "https://github.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Joel Mnisi",
            "email": "joel.mnisi@protonmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/http": "^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "rainwaves\\PaystackPayment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "rainwaves\\PaystackPayment\\PaystackServiceProvider"
            ],
            "config": [
                "paystack.php"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
