{
    "name": "rainwaves/paystack-payment",
    "description": "Laravel package for Paystack single payments, subscriptions, webhooks, and refunds.",
    "type": "library",
    "keywords": [
        "rainwaves",
        "paystack-payment",
        "payments",
        "paystack"
    ],
    "homepage": "https://github.com/Magnificent-Big-J/paystack-payment",
    "license": "MIT",
    "authors": [
        {
            "name": "Joel Mnisi",
            "email": "joel.mnisi@protonmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0",
        "illuminate/http": "^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "rainwaves\\PaystackPayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rainwaves\\PaystackPayment\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "@php -r \"foreach (['src', 'config', 'tests'] as $dir) { if (!is_dir($dir)) continue; $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir)); foreach ($it as $file) { if ($file->isFile() && $file->getExtension() === 'php') { passthru('php -l '.escapeshellarg($file->getPathname()), $code); if ($code !== 0) exit($code); } } } echo 'PHP lint passed'.PHP_EOL;\""
        ],
        "test": [
            "@php vendor/bin/phpunit --configuration phpunit.xml --testdox"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "rainwaves\\PaystackPayment\\PaystackServiceProvider"
            ],
            "config": [
                "paystack.php"
            ]
        }
    },
    "support": {
        "source": "https://github.com/Magnificent-Big-J/paystack-payment"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
